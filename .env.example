# Generate new secrets before deployment. URL-encode the password in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-new-random-password
DATABASE_URL=postgresql://admin:replace-with-new-random-password@db:5432/toporider_db
# Firebase Console > Project settings > Your apps > Web app config (public values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
