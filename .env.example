# 배포 전에 새 비밀번호를 설정하세요. DATABASE_URL의 비밀번호는 URL 인코딩이 필요합니다.
POSTGRES_PASSWORD=replace-with-new-random-password
DATABASE_URL=postgresql://admin:replace-with-new-random-password@db:5432/toporider_db
# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱 구성에서 확인하는 공개 설정값
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Google Analytics 4 측정 ID. 운영 빌드(vite build)에서만 사용하며, 비워 두면 수집하지 않습니다.
VITE_GA_MEASUREMENT_ID=G-N9W8ZFDRHC
# 선택: Google Cloud Console에서 Maps JavaScript API를 활성화하고 발급한 브라우저 키.
# 웹사이트(HTTP referrer)와 Maps JavaScript API로 사용 범위를 제한하세요. 설정 후 프런트 재빌드 필요.
VITE_GOOGLE_MAPS_API_KEY=
# OSM은 기본 공개 타일을 쓰면 키가 필요 없습니다. 운영 공급자를 쓰면 URL에 키를 넣을 수 있습니다.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# HTML 대신 출처 문구를 입력하세요. 외부 공급자의 필수 출처도 함께 적습니다.
VITE_OSM_ATTRIBUTION=© OpenStreetMap contributors
# 관리자 페이지(/admin/) 계정. 비워 두면 관리자 페이지를 쓰지 않습니다. 비밀번호는 8자 이상이어야 합니다.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 선택: 관리자 로그인 토큰 서명 키(32자 이상 무작위 값). 비워 두면 백엔드를 다시 시작할 때마다 다시 로그인합니다.
ADMIN_SESSION_SECRET=
# 운영 DB 백업 폴더(호스트 경로). 폴더가 없으면 백업 컨테이너가 시작하지 않습니다.
BACKUP_DIR=/srv/storage/backups/trazo
# 선택: 백업 시각(한국 시간)과 보관 일수
# BACKUP_TIME=03:30
# BACKUP_KEEP_DAYS=30
# AI 연결(MCP 서버, /ai/ 화면). AI 서비스에 알려 주는 서비스 주소입니다. 운영은 비워 두면 https://trazo.runvia.app,
# 개발 환경에서 로컬로 시험하려면 http://localhost:3000 처럼 브라우저로 접속하는 주소를 넣습니다.
PUBLIC_BASE_URL=
# 선택: 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키의 'REST API 키' (지도에 쓰는 JavaScript 키와 다릅니다).
# 있으면 AI에게 코스가 지나는 지역 이름과 장소 검색(find_place)을 제공하고, 없으면 좌표만 제공합니다.
KAKAO_REST_API_KEY=
# 선택: 운영 계정 구글 이메일(쉼표로 구분). 이 계정이 전체 공개한 코스는 관리자 페이지에서 만든 가상 계정 이름으로 보여줍니다.
SEED_ACCOUNT_EMAILS=
# 선택: 좋아요 봇(like-bot 컨테이너)과 백엔드가 함께 쓰는 비밀 값(32자 이상 무작위). 비워 두면 좋아요 봇이 쉽니다.
LIKE_BOT_TOKEN=
# LIKE_BOT_MIN_MINUTES=30
# LIKE_BOT_MAX_MINUTES=240
# 좋아요를 누르지 않는 시간대(한국 시간)
# LIKE_BOT_QUIET_HOURS=1-7
# 선택: AI 마켓(ChatGPT·Claude) 심사자 전용 로그인. 비밀번호는 12자 이상, REVIEWER_UID는 심사용 구글 계정의 Firebase UID (mcp/reviewer-info.md)
REVIEWER_LOGIN_ID=
REVIEWER_LOGIN_PASSWORD=
REVIEWER_UID=
# 선택: OpenAI 플러그인 제출 화면의 도메인 인증 토큰
OPENAI_APPS_CHALLENGE=
