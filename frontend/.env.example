VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_URL=/api
# Google Analytics 4 측정 ID. 운영 빌드(vite build)에서만 사용하며, 비워 두면 수집하지 않습니다.
VITE_GA_MEASUREMENT_ID=G-N9W8ZFDRHC
# 지도 선택: Google Cloud > Maps JavaScript API의 브라우저 키. 발급 방법은 docs/map-providers.md 참고.
VITE_GOOGLE_MAPS_API_KEY=
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ATTRIBUTION=© OpenStreetMap contributors
